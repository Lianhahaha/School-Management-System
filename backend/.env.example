# Copy this file to backend/.env and fill in the values. The server is started from backend/
# (npm run dev), which loads .env through Node's --env-file-if-exists flag.

# ---- Runtime --------------------------------------------------------------
NODE_ENV=development
PORT=3000
# Comma-separated origins allowed to call the API directly. Not needed when the
# frontend uses the Vite dev proxy (the default), harmless to leave as is.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# debug (prints every SQL statement) | info | warn | error
LOG_LEVEL=info
# Serve Swagger UI at /api/docs
DOCS_ENABLED=true
# Allow POST /auth/register (creates student accounts). Set to false to force admin-created accounts only.
ALLOW_PUBLIC_REGISTRATION=true
# IANA time zone used for "today" and weekday calculations (e.g. Asia/Manila, Europe/Berlin).
# Leave empty to use this machine's time zone.
APP_TIMEZONE=
# Month (1-12) in which the academic year starts. 8 = August.
ACADEMIC_YEAR_START_MONTH=8

# ---- MySQL ----------------------------------------------------------------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
# Wrap the value in double quotes if it contains #, $ or spaces, e.g. "my#pass"
DB_PASSWORD=
DB_NAME=school_management
DB_CONNECTION_LIMIT=10

# ---- Firebase Admin -------------------------------------------------------
# Path (relative to backend/) to the service-account JSON downloaded from
# Firebase console > Project settings > Service accounts > Generate new private key.
# Save the downloaded file exactly as backend/firebase-service-account.json (git-ignored).
FIREBASE_SERVICE_ACCOUNT_PATH=./firebase-service-account.json

# ---- Scripts --------------------------------------------------------------
# Password given to every seeded demo account (npm run db:seed).
SEED_PASSWORD=Password123!
