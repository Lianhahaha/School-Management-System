{
  "name": "school-management-backend",
  "version": "1.0.0",
  "private": true,
  "description": "REST API for the School Management System (Express 5 + MySQL 8 + Firebase Authentication)",
  "type": "module",
  "engines": {
    "node": ">=22.22"
  },
  "scripts": {
    "dev": "node --watch --env-file-if-exists=.env src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "test": "npm run check:constants && node --env-file-if-exists=.env --test --test-concurrency=1 \"tests/**/*.test.js\"",
    "lint": "eslint .",
    "format": "prettier --write .",
    "db:migrate": "node --env-file-if-exists=.env scripts/migrate.js",
    "db:seed": "node --env-file-if-exists=.env scripts/seed.js",
    "db:reset": "node --env-file-if-exists=.env scripts/migrate.js --fresh && node --env-file-if-exists=.env scripts/seed.js",
    "check:constants": "node scripts/check-constants.js",
    "check:secrets": "node scripts/check-secrets.js",
    "doctor": "node --env-file-if-exists=.env scripts/doctor.js",
    "token": "node --env-file-if-exists=.env scripts/get-token.js"
  },
  "dependencies": {
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "firebase-admin": "^14.5.0",
    "helmet": "^8.3.0",
    "morgan": "^1.12.1",
    "mysql2": "^3.24.5",
    "swagger-ui-express": "^5.0.1",
    "yaml": "^2.9.1",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "globals": "^17.13.0",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1"
  }
}
