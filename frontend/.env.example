# Copy this file to frontend/.env and fill in the values, then (re)start `npm run dev`.
# Vite only exposes variables prefixed with VITE_ and reads them at start-up.

# Firebase web app config: Firebase console > Project settings > General > Your apps > Web app.
# These values are public by design, but they MUST belong to the same Firebase project as
# backend/firebase-service-account.json, otherwise every API call fails with a token audience error.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your-project-id
VITE_FIREBASE_APP_ID=

# API base path. The default goes through the Vite dev proxy to http://127.0.0.1:3000 (no CORS).
# Set an absolute URL (e.g. https://api.example.com/api/v1) only for a deployed build.
VITE_API_BASE_URL=/api/v1

# Optional, for a public demo: sign-ins listed (folded) under the sign-in form, one line of JSON:
# {"password":"…","accounts":[{"role":"Admin","email":"…"},{"role":"Teacher","email":"…"}]}
# Leave it unset and the sign-in page lists nothing. Never put a real person's account here.
VITE_DEMO_ACCOUNTS=
